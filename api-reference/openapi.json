            "style": "form",
            "explode": false
          },
          {
            "name": "build_area",
            "in": "query",
            "description": "Exact build area in sqm.",
            "schema": { "type": "number" }
          },
          {
            "name": "build_area_min",
            "in": "query",
            "schema": { "type": "number" }
          },
          {
