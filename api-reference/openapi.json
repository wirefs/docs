    "/api/properties/{id}/": {
      "get": {
        "summary": "Retrieve a property",
        "operationId": "retrieveProperty",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": {
            "description": "A single property",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Property" }
              }
            }
          },
          "404": { "description": "Not found" }
        }
      }
    },
